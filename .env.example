# Port for the local explorer UI
PORT=4545

# --- Copilot Studio MCP bridge (@microsoft/copilot-studio-mcp) ---
# "bundled" runs the copy installed in node_modules (pinned in package.json).
# "npx" runs `npx -y @microsoft/copilot-studio-mcp@latest`, which is what VS Code / Copilot CLI do.
COPILOT_STUDIO_MCP_LAUNCH=bundled

# --- Microsoft Entra sign-in used by this app (Dataverse Web API, Dataverse MCP, agent chat) ---
# Public-client app registration (enable "Allow public client flows" for device code sign-in).
# Required delegated permissions:
#   Dynamics CRM            -> user_impersonation   (Dataverse Web API, Global Discovery)
#   Dynamics CRM            -> mcp.tools            (Dataverse MCP remote endpoint /api/mcp)
#   Power Platform API      -> CopilotStudio.Copilots.Invoke  (agent chat via @microsoft/agents-copilotstudio-client)
# The default is the Microsoft sample public client used by the Copilot Studio MCP bridge and Dataverse samples.
AZURE_CLIENT_ID=51f81489-12ee-4a9e-aaae-a2591f45987d
# "organizations" lets any work account sign in; set your tenant ID to pin it.
AZURE_TENANT_ID=organizations
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
